<Window x:Class="KlantenSimulatorUI_WPF.SimulationDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KlantenSimulatorUI_WPF"
        mc:Ignorable="d"
        Title="SimulationDataWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button Grid.Row="0" Content="Save Data" Width="100" Margin="10" Click="SaveData_Click"/>
        <DataGrid Grid.Row="1" x:Name="SimulationDataGrid"/>

    </Grid>
</Window>
