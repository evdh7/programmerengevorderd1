<Window x:Class="KlantenSimulatorUI_WPF.ParametersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KlantenSimulatorUI_WPF"
        mc:Ignorable="d"
        Title="ParametersWindow" Height="450" Width="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>


        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="5" VerticalAlignment="Center" TextAlignment="Center" Text="Simulation Tool Parameters"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Margin="5" Text="Country"/>

        <ComboBox Grid.Row="1" Grid.Column="1" Margin="5" Name="ComboBox_Countries" SelectionChanged="Country_Selected" ></ComboBox>

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="5" Text="City"/>
        <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="5">
            <RadioButton Content="Select All Cities" x:Name="RadioSelectAllCities"  Margin="5" IsChecked="True"/>
            <Button Content="City Selection Tool (optional)" x:Name="SelectCities" Margin="5" Click= "SelectCities_Click"/>
        </StackPanel>
        <Label Grid.Row="3" Grid.Column="0" x:Name="Label_SelectedCitiesSummary" Visibility="Collapsed" Margin="5" FontWeight="Bold" />

        <Button Grid.Row="3" Grid.Column="1" Margin="5" Content="View selected cities" x:Name="Button_ViewSelectedCities" Visibility="Collapsed" Click="Button_ViewSelectedCities_Click" />
        <TextBlock Grid.Row="4" Grid.Column="0" Margin="5" Text="Amount Of Simulated Customers"/>
        <TextBox Grid.Row="4" Grid.Column="1" Margin="5" Name="TextBoxAmount" PreviewTextInput="TextBoxAmount_PreviewTextInput" MaxLength="7"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Margin="5" x:Name="MinAge" Text="Minimum Customer Age"/>
        <TextBox Grid.Row="5" Grid.Column="1" Margin="5" PreviewTextInput="TextBoxAmount_PreviewTextInput" x:Name="TextBoxMinAge" MaxLength="2"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Margin="5" Text="Maximum Customer Age"/>
        <TextBox Grid.Row="6" Grid.Column="1" Margin="5" PreviewTextInput="TextBoxAmount_PreviewTextInput" x:Name="TextBoxMaxAge" MaxLength="3"/>
        
        <Button Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Content="Address Parameters" Margin="5" Click="AddressParameters_Click"/>
        <ListBox Grid.Row="8" Grid.ColumnSpan="2" Visibility="Collapsed" x:Name="AddressInput"/>
        <Button Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Content="StartSimulation" Margin="5" Click="ButtonClick_StartWindow"/>
    </Grid>
</Window>
