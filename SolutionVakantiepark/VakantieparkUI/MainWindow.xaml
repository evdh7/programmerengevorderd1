<Window x:Class="VakantieparkUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VakantieparkUI"
        mc:Ignorable="d"
        Title="Beheer Vakantiepark" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DataGrid Grid.Row="0" Name="DataGridVakantieparken" Margin="5" SelectionMode="Single" IsReadOnly="True" MouseDoubleClick="ToonWooneenheden_DoubleClick">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="New" Click="MenuItemMaakVakantieparkNew_Click"/>
                    <MenuItem Header="Update"/>
                    <MenuItem Header="Delete"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
        <DataGrid Grid.Row="1" Name="DataGridWooneenheden" Margin="5" SelectionMode="Single" IsReadOnly="True"/>
    </Grid>
</Window>
